[Unit]
Description=GitHub Actions runner for year-end-radio
After=network-online.target docker.service tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/actions-runner/year-end-radio
ExecStart=%h/actions-runner/year-end-radio/run.sh
Restart=always
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=default.target

